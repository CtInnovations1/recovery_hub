<?php
declare(strict_types=1);

require_once __DIR__ . '/../config/database.php';

$currentPage = 'reroute';

function h(?string $value): string
{
    return htmlspecialchars(
        (string)$value,
        ENT_QUOTES,
        'UTF-8'
    );
}

function recoveryLabel(string $type): string
{
    return match ($type) {
        'REC_WHATNOT'   => 'Whatnot',
        'REC_WHOLESALE' => 'Wholesale',
        'REC_REPAIR'    => 'Repair',
        'REC_HARVEST'   => 'Harvest',
        default         => $type,
    };
}

$types = [
    'REC_WHATNOT',
    'REC_WHOLESALE',
    'REC_REPAIR',
    'REC_HARVEST',
];

/*
|--------------------------------------------------------------------------
| Active destination mapping
|--------------------------------------------------------------------------
*/

$pathToArea = [
    'REC_WHATNOT'   => 'RETAIL_ELIGIBLE',
    'REC_WHOLESALE' => 'WHOLESALE',
    'REC_REPAIR'    => 'REPAIR',
    'REC_HARVEST'   => 'HARVEST',
];

$areaToPath =
    array_flip(
        $pathToArea
    );

$destinationRows = $pdo->query("
    SELECT
        erp_location_id,
        location_name,
        recovery_area,
        location_status
    FROM recovery_locations
    WHERE is_active = 1
      AND is_visible = 1
    ORDER BY
        recovery_area,
        location_name
")->fetchAll(PDO::FETCH_ASSOC);

$destinations = [];

foreach ($types as $type) {
    $destinations[$type] = [];
}

foreach ($destinationRows as $row) {

    $area =
        (string)($row['recovery_area'] ?? '');

    $path =
        $areaToPath[$area]
        ?? null;

    if (
        $path === null
        ||
        !isset($destinations[$path])
    ) {
        continue;
    }

    $destinations[$path][] = [
        'erp_location_id' =>
            (int)$row['erp_location_id'],

        'location_name' =>
            (string)$row['location_name'],

        'recovery_area' =>
            $area,

        'location_status' =>
            (string)$row['location_status'],
    ];
}

/*
|--------------------------------------------------------------------------
| Pending reroutes
|--------------------------------------------------------------------------
*/

$pendingStmt = $pdo->query("
    SELECT
        r.id,
        r.serial_number,
        d.product_id,
        r.original_recovery_type,
        r.new_recovery_type,
        r.original_location_name,
        r.new_location_name,
        r.reroute_reason,
        r.requested_at
    FROM recovery_reroutes r
    LEFT JOIN recovery_devices d
        ON d.id = r.recovery_device_id
    WHERE r.status = 'PENDING'
    ORDER BY
        r.requested_at DESC,
        r.id DESC
    LIMIT 100
");

$pendingReroutes =
    $pendingStmt->fetchAll(PDO::FETCH_ASSOC);

?>
