<script>

const destinations =
    <?= json_encode(
        $destinations,
        JSON_UNESCAPED_SLASHES |
        JSON_UNESCAPED_UNICODE
    ) ?>;

let currentDevice = null;


function valueOrDash(value)
{
    if (
        value === null ||
        value === undefined ||
        value === ''
    ) {
        return '—';
    }

    return String(value);
}


function recoveryLabel(type)
{
    const labels = {
        REC_WHATNOT: 'Whatnot',
        REC_WHOLESALE: 'Wholesale',
        REC_REPAIR: 'Repair',
        REC_HARVEST: 'Harvest',
        REVIEW_REQUIRED: 'Review Required'
    };

    return labels[type] || valueOrDash(type);
}



function isInitialRouting(device)
{
    if (!device) {
        return false;
    }

    return (
        device.recovery_status === 'PENDING_RECOVERY_REVIEW' ||
        device.recovery_type === 'REVIEW_REQUIRED' ||
        !device.recovery_type
    );
}


function applyRoutingMode(device)
{
    const initial = isInitialRouting(device);

    document.getElementById(
        'workflowTitle'
    ).textContent =
        initial
            ? 'Assign Initial Recovery Path'
            : 'Create Reroute';

    document.getElementById(
        'workflowSubtitle'
    ).textContent =
        initial
            ? 'Scan device → review defects → assign path → create physical movement'
            : 'Scan device → select new path → select destination bin → create movement';

    document.getElementById(
        'routeStepText'
    ).textContent =
        initial
            ? 'Assign initial Recovery Path'
            : 'Select new Recovery Path';

    document.getElementById(
        'newRecoveryTypeLabel'
    ).textContent =
        initial
            ? 'Recovery Path'
            : 'New Recovery Path';

    document.getElementById(
        'reasonLabel'
    ).textContent =
        initial
            ? 'Routing Reason'
            : 'Reroute Reason';

    document.getElementById(
        'rerouteReason'
    ).placeholder =
        initial
            ? 'Why is this Recovery Path being assigned?'
            : 'Why is this device being rerouted?';

    document.getElementById(
        'createButton'
    ).textContent =
        initial
            ? 'Create Initial Movement'
            : 'Create Pending Movement';
}


function showMessage(
    element,
    message,
    type
) {
    element.textContent = message;

    element.className =
        'message visible ' + type;
}


function clearMessage(element)
{
    element.textContent = '';
    element.className = 'message';
}


async function lookupDevice()
{
    const serialInput =
        document.getElementById(
            'serialInput'
        );

    const serial =
        serialInput.value.trim();

    const message =
        document.getElementById(
            'lookupMessage'
        );

    const panel =
        document.getElementById(
            'devicePanel'
        );

    clearMessage(message);

    panel.classList.remove(
        'visible'
    );

    currentDevice = null;

    if (!serial) {

        showMessage(
            message,
            'Enter or scan a serial number.',
            'error'
        );

        serialInput.focus();

        return;
    }

    try {

        const response = await fetch(
            '/api/reroute/device_lookup.php?serial=' +
            encodeURIComponent(serial),
            {
                headers: {
                    'Accept': 'application/json'
                }
            }
        );

        const result =
            await response.json();

        if (
            !response.ok ||
            !result.success
        ) {

            throw new Error(
                result.message ||
                'Device not found.'
            );
        }

        currentDevice =
            result.device;

        if (
            currentDevice.pending_reroute
        ) {

            showMessage(
                message,
                'This device already has a pending reroute.',
                'error'
            );

            return;
        }

        renderDevice(
            currentDevice
        );

        panel.classList.add(
            'visible'
        );

        document.getElementById(
            'newRecoveryType'
        ).focus();

    } catch (error) {

        showMessage(
            message,
            error.message ||
            'Unable to find device.',
            'error'
        );
    }
}


function renderDevice(device)
{
    document.getElementById(
        'deviceSerial'
    ).textContent =
        valueOrDash(
            device.serial_number
        );

    document.getElementById(
        'deviceProduct'
    ).textContent =
        valueOrDash(
            device.product_id
        );

    document.getElementById(
        'deviceStatus'
    ).textContent =
        valueOrDash(
            device.recovery_status
        );

    document.getElementById(
        'currentPath'
    ).textContent =
        recoveryLabel(
            device.recovery_type
        );

    document.getElementById(
        'currentLocation'
    ).textContent =
        valueOrDash(
            device.location_name
        );

    document.getElementById(
        'erpDeviceId'
    ).textContent =
        valueOrDash(
            device.erp_device_id
        );

    document.getElementById(
        'deviceGrade'
    ).textContent =
        valueOrDash(
            device.grade
        );


    const defectContainer =
        document.getElementById(
            'deviceDefects'
        );

    defectContainer.innerHTML = '';

    if (
        Array.isArray(device.defects) &&
        device.defects.length > 0
    ) {

        device.defects.forEach(
            defect => {

                const element =
                    document.createElement(
                        'span'
                    );

                element.className =
                    'defect';

                element.textContent =
                    defect.defect_code;

                defectContainer.appendChild(
                    element
                );
            }
        );

    } else {

        const element =
            document.createElement(
                'span'
            );

        element.className =
            'muted';

        element.textContent =
            'No defect codes';

        defectContainer.appendChild(
            element
        );
    }


    applyRoutingMode(device);

    const pathSelect =
        document.getElementById(
            'newRecoveryType'
        );

    pathSelect.value = '';

    const initialRouting =
        isInitialRouting(device);

    Array.from(
        pathSelect.options
    ).forEach(option => {

        option.disabled =
            !initialRouting &&
            option.value !== '' &&
            option.value ===
                device.recovery_type;
    });

    document.getElementById(
        'rerouteReason'
    ).value = '';

    document.getElementById(
        'destinationBox'
    ).classList.remove(
        'visible'
    );

    clearMessage(
        document.getElementById(
            'createMessage'
        )
    );
}


function updateDestination()
{
    const path =
        document.getElementById(
            'newRecoveryType'
        ).value;

    const box =
        document.getElementById(
            'destinationBox'
        );

    const nameContainer =
        document.getElementById(
            'destinationName'
        );

    const meta =
        document.getElementById(
            'destinationMeta'
        );

    const list =
        path &&
        Array.isArray(
            destinations[path]
        )
            ? destinations[path]
            : [];

    nameContainer.innerHTML = '';
    meta.textContent = '—';

    if (
        !path ||
        list.length === 0
    ) {

        box.classList.remove(
            'visible'
        );

        return;
    }

    const select =
        document.createElement(
            'select'
        );

    select.id =
        'destinationLocation';

    const placeholder =
        document.createElement(
            'option'
        );

    placeholder.value = '';
    placeholder.textContent =
        'Select Physical Destination';

    select.appendChild(
        placeholder
    );

    list.forEach(
        location => {

            const option =
                document.createElement(
                    'option'
                );

            option.value =
                String(
                    location.erp_location_id
                );

            option.textContent =
                location.location_name +
                ' · ' +
                valueOrDash(
                    location.location_status
                );

            option.dataset.locationStatus =
                valueOrDash(
                    location.location_status
                );

            select.appendChild(
                option
            );
        }
    );

    select.addEventListener(
        'change',
        function () {

            const selected =
                select.options[
                    select.selectedIndex
                ];

            if (!selected.value) {

                meta.textContent =
                    list.length +
                    (
                        list.length === 1
                            ? ' synced ERP location'
                            : ' synced ERP locations'
                    ) +
                    ' · Select the physical bin';

                return;
            }

            meta.textContent =
                'ERP Location #' +
                selected.value +
                ' · ' +
                selected.dataset.locationStatus;
        }
    );

    nameContainer.appendChild(
        select
    );

    meta.textContent =
        list.length +
        (
            list.length === 1
                ? ' synced ERP location'
                : ' synced ERP locations'
        ) +
        ' · Select the physical bin';

    box.classList.add(
        'visible'
    );
}


async function createReroute()
{
    if (!currentDevice) {
        return;
    }

    const path =
        document.getElementById(
            'newRecoveryType'
        ).value;

    const destinationSelect =
        document.getElementById(
            'destinationLocation'
        );

    const destinationLocationId =
        destinationSelect
            ? parseInt(
                destinationSelect.value,
                10
            )
            : 0;

    const reason =
        document.getElementById(
            'rerouteReason'
        ).value.trim();

    const message =
        document.getElementById(
            'createMessage'
        );

    const button =
        document.getElementById(
            'createButton'
        );

    clearMessage(message);

    if (!path) {

        showMessage(
            message,
            isInitialRouting(currentDevice)
                ? 'Select a Recovery Path.'
                : 'Select a new Recovery Path.',
            'error'
        );

        return;
    }

    if (
        !Array.isArray(
            destinations[path]
        )
        ||
        destinations[path].length === 0
    ) {

        showMessage(
            message,
            'No active ERP destination is available for this path.',
            'error'
        );

        return;
    }

    if (
        !destinationLocationId
        ||
        Number.isNaN(
            destinationLocationId
        )
    ) {

        showMessage(
            message,
            'Select a physical destination bin.',
            'error'
        );

        return;
    }

    if (!reason) {

        showMessage(
            message,
            isInitialRouting(currentDevice)
                ? 'Enter a routing reason.'
                : 'Enter a reroute reason.',
            'error'
        );

        return;
    }

    button.disabled = true;

    try {

        const response = await fetch(
            '/api/reroute/create.php',
            {
                method: 'POST',

                headers: {
                    'Content-Type':
                        'application/json',

                    'Accept':
                        'application/json'
                },

                body: JSON.stringify({
                    device_id:
                        currentDevice.id,

                    new_recovery_type:
                        path,

                    destination_location_id:
                        destinationLocationId,

                    reason:
                        reason,

                    routing_mode:
                        isInitialRouting(currentDevice)
                            ? 'INITIAL'
                            : 'REROUTE'
                })
            }
        );

        const result =
            await response.json();

        if (
            !response.ok ||
            !result.success
        ) {

            throw new Error(
                result.message ||
                'Unable to create reroute.'
            );
        }

        showMessage(
            message,
            (
                isInitialRouting(currentDevice)
                    ? 'Initial routing created. Move the device to '
                    : 'Pending reroute created. Move the device to '
            ) +
            result.reroute.new_location_name +
            '.',
            'success'
        );

        await refreshPending();

        currentDevice.pending_reroute =
            result.reroute;

        button.disabled = true;

    } catch (error) {

        showMessage(
            message,
            error.message ||
            'Unable to create reroute.',
            'error'
        );

        button.disabled = false;
    }
}


async function refreshPending()
{
    try {

        const response = await fetch(
            '/api/reroute/pending.php',
            {
                headers: {
                    'Accept':
                        'application/json'
                }
            }
        );

        const result =
            await response.json();

        if (
            !response.ok ||
            !result.success
        ) {
            return;
        }

        renderPending(
            result.reroutes
        );

    } catch (error) {

        console.error(
            'Unable to refresh pending reroutes.'
        );
    }
}


function renderPending(reroutes)
{
    const list =
        document.getElementById(
            'pendingList'
        );

    const count =
        document.getElementById(
            'pendingCount'
        );

    count.textContent =
        reroutes.length;

    list.innerHTML = '';

    if (!reroutes.length) {

        const empty =
            document.createElement(
                'div'
            );

        empty.className =
            'pending-empty';

        empty.textContent =
            'No pending reroutes.';

        list.appendChild(
            empty
        );

        return;
    }


    reroutes.forEach(
        reroute => {

            const item =
                document.createElement(
                    'div'
                );

            item.className =
                'pending-item';


            const serial =
                document.createElement(
                    'div'
                );

            serial.className =
                'pending-serial';

            serial.textContent =
                valueOrDash(
                    reroute.serial_number
                );


            const product =
                document.createElement(
                    'div'
                );

            product.className =
                'pending-product';

            product.textContent =
                valueOrDash(
                    reroute.product_id
                );


            const route =
                document.createElement(
                    'div'
                );

            route.className =
                'route-line';


            const from =
                document.createElement(
                    'span'
                );

            from.className =
                'route-path';

            from.textContent =
                recoveryLabel(
                    reroute.original_recovery_type
                );


            const arrow =
                document.createElement(
                    'span'
                );

            arrow.className =
                'route-arrow';

            arrow.textContent =
                '→';


            const to =
                document.createElement(
                    'span'
                );

            to.className =
                'route-path';

            to.textContent =
                recoveryLabel(
                    reroute.new_recovery_type
                );


            route.appendChild(from);
            route.appendChild(arrow);
            route.appendChild(to);


            const location =
                document.createElement(
                    'div'
                );

            location.className =
                'pending-location';

            location.textContent =
                'Destination: ' +
                valueOrDash(
                    reroute.new_location_name
                );


            const reason =
                document.createElement(
                    'div'
                );

            reason.className =
                'pending-reason';

            reason.textContent =
                valueOrDash(
                    reroute.reroute_reason
                );


            const time =
                document.createElement(
                    'div'
                );

            time.className =
                'pending-time';

            time.textContent =
                'Requested: ' +
                valueOrDash(
                    reroute.requested_at
                );


            item.appendChild(serial);
            item.appendChild(product);
            item.appendChild(route);
            item.appendChild(location);
            item.appendChild(reason);
            item.appendChild(time);

            list.appendChild(item);
        }
    );
}


document.getElementById(
    'serialInput'
).addEventListener(
    'keydown',
    function(event) {

        if (event.key === 'Enter') {

            event.preventDefault();

            lookupDevice();
        }
    }
);

